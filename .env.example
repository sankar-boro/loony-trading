# ── Loony Trading — Environment Variables ─────────────────────────────────────
# Setup:
#   cp .env.example .env
#   # Fill in your values below
#   python scripts/upstox_login.py   # get your access token
#   ./loony.sh start                 # start the dashboard
#
# .env is in .gitignore — NEVER commit it to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Upstox (required — Indian markets primary data + trading) ─────────────────
# Register at https://upstox.com/developer/api-documentation/
# The redirect URI must exactly match what you registered in the Upstox app.
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:3561/callback

# Daily access token — refreshed by: python scripts/upstox_login.py
# Saved automatically to data/upstox_token.json; set here as fallback.
UPSTOX_ACCESS_TOKEN=

# ── Telegram (optional — trade alerts, daily P&L summary) ────────────────────
# 1. Create bot via @BotFather → copy token
# 2. Send /start to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  → find "chat":{"id":...}
# Test: curl http://localhost:8000/api/telegram/test
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── News / Sentiment (optional) ───────────────────────────────────────────────
# Free tier: 100 requests/day — https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# ── Binance (optional — secondary crypto market) ─────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Email alerts (optional) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password   # Gmail: use an App Password, not your login password
EMAIL_TO=recipient@example.com

# ── Persistence (MarketPulse AI Phase 0) ──────────────────────────────────────
# Local dev default matches docker-compose's `db` service exposed on localhost.
DATABASE_URL=postgresql+psycopg2://loony:loony@localhost:5432/loony_trading
# ...or, instead of DATABASE_URL, the parts (DATABASE_URL wins if both are set):
# DB_NAME=loony_trading
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=loony
# DB_PASSWORD=loony
# Optional: keep every table in this Postgres schema instead of `public`
# DB_SCHEMA=basic
POSTGRES_USER=loony
POSTGRES_PASSWORD=loony
POSTGRES_DB=loony_trading
REDIS_URL=redis://localhost:6379/0

# ── AI / LLM (MarketPulse AI Phase 0) ─────────────────────────────────────────
# LLM_PROVIDER=demo runs fully offline with deterministic canned responses —
# no key required. Set to "anthropic" + fill ANTHROPIC_API_KEY for real calls.
LLM_PROVIDER=demo
ANTHROPIC_API_KEY=

# ── Dashboard login ──────────────────────────────────────────────────────────
# Without a password the dashboard only answers the machine it runs on.
# Set one to use it from another device or from Docker (see docs/operations/deployment.md).
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_HOURS=12
