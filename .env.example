# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ── Upstox (Primary — Indian Markets) ─────────────────────────────────────────
# Register at https://upstox.com/developer/api-documentation/
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
# redirect_uri must exactly match what you registered in the Upstox developer console
UPSTOX_REDIRECT_URI=http://localhost:8888/callback
# Optional: pre-obtained access token (avoids browser auth on each start)
UPSTOX_ACCESS_TOKEN=

UPSTOX_ANALYTICS_API_KEY=your_analytics_token_here

# ── Binance (Secondary — Crypto) ──────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Alpaca (stocks)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Email
SMTP_HOST=smtp.gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=recipient@example.com

# News sentiment
NEWS_API_KEY=your_newsapi_key_here

